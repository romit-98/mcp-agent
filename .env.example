POSTGRES_USER=northstar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=northstar
# Host port. 5433 avoids clashing with a locally installed Postgres on 5432.
POSTGRES_PORT=5433

# CRM MCP server (services/mcp-crm). Until phase 6 it uses the same DB user as above.
CRM_DB_USER=northstar
CRM_DB_PASSWORD=change-me
# Trust the X-Dev-User / X-Dev-Role headers (local testing only, removed in phase 5).
CRM_DEV_AUTH=false
# Host port for the CRM container (bound to localhost only).
CRM_HOST_PORT=8001

# Finance MCP server (services/mcp-finance). Same DB user as above until phase 6.
FIN_DB_USER=northstar
FIN_DB_PASSWORD=change-me
FIN_DEV_AUTH=false
FIN_HOST_PORT=8002

# Email MCP server, mock (services/mcp-email). Same DB user as above until phase 6.
EMAIL_DB_USER=northstar
EMAIL_DB_PASSWORD=change-me
EMAIL_DEV_AUTH=false
EMAIL_HOST_PORT=8003

# Knowledge MCP server (services/mcp-knowledge). Same DB user as above until phase 6.
KNOW_DB_USER=northstar
KNOW_DB_PASSWORD=change-me
KNOW_DEV_AUTH=false
KNOW_HOST_PORT=8004
# Where the embedding model is cached locally (default: fastembed's temp cache).
# KNOW_MODEL_CACHE_DIR=

# Agent LLM (services/agent). Create a key at https://platform.claude.com -> API keys.
ANTHROPIC_API_KEY=sk-ant-change-me
AGENT_MODEL=claude-haiku-5-5

# INSECURE baseline server (services/mcp-insecure, phase 4 only).
INSECURE_DB_USER=northstar
INSECURE_DB_PASSWORD=change-me

# Eval harness (evals/harness): reads ground truth and cleans up writes between runs.
EVAL_DB_USER=northstar
EVAL_DB_PASSWORD=change-me
